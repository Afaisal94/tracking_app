APP_ENV=production
APP_PORT=8080
APP_HOST=0.0.0.0

# Database
DATABASE_URL=postgres://tracking:tracking_secret@localhost:5432/tracking_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-super-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h  # 30 days
JWT_ISSUER=tracking-backend

# WebSocket
WS_IDLE_TIMEOUT=15m
WS_FLUSH_INTERVAL=10s
WS_FLUSH_BATCH_SIZE=50

# Rate limiting
RATE_LIMIT_AUTH_RPS=5
RATE_LIMIT_AUTH_BURST=10

# CORS
CORS_ALLOWED_ORIGINS=
